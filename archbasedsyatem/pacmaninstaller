
import subprocess
import shutil
import os

AUTHOR = "Blackreaper38 on GitHub"


def header():
    os.system("clear")
    print("==============================")
    print("     PAC-MAN SIMPLEINSTALLER")
    print("==============================")
    print()


def run_command(command):
    try:
        subprocess.run(command, check=False)
    except FileNotFoundError:
        print("Error: Required command not found.")


def search_packages():
    header()
    package = input("Enter package name: ").strip()

    if package:
        run_command(["pacman", "-Ss", package])

    input("\nPress Enter to continue...")


def install_package():
    header()
    package = input("Enter package name: ").strip()

    if package:
        run_command(["sudo", "pacman", "-S", "--needed", package])

    input("\nPress Enter to continue...")


def install_from_file():
    header()
    path = input("Enter TXT file path: ").strip()

    if not os.path.isfile(path):
        print("File not found.")
        input("\nPress Enter to continue...")
        return

    with open(path, "r", encoding="utf-8") as file:
        packages = [
            line.strip()
            for line in file
            if line.strip() and not line.strip().startswith("#")
        ]

    if not packages:
        print("No packages found.")
    else:
        print(f"\nFound {len(packages)} packages.")
        confirm = input("Install all? (y/n): ").lower()

        if confirm == "y":
            run_command(
                ["sudo", "pacman", "-S", "--needed", *packages]
            )

    input("\nPress Enter to continue...")


def update_system():
    header()
    print("Updating Arch Linux...")
    run_command(["sudo", "pacman", "-Syu"])
    input("\nPress Enter to continue...")


def remove_package():
    header()
    package = input("Enter package name: ").strip()

    if package:
        confirm = input(f"Remove {package}? (y/n): ").lower()

        if confirm == "y":
            run_command(["sudo", "pacman", "-R", package])

    input("\nPress Enter to continue...")


def main():
    while True:
        header()

        print("[1] Package Search Engine")
        print("[2] Install Package")
        print("[3] Personalized AutoInstall")
        print("[4] Update System")
        print("[5] Remove Package")
        print("[6] Exit")
        print()

        option = input("Select an option: ").strip()

        if option == "1":
            search_packages()

        elif option == "2":
            install_package()

        elif option == "3":
            install_from_file()

        elif option == "4":
            update_system()

        elif option == "5":
            remove_package()

        elif option == "6":
            print(f"\nAuthor: {AUTHOR}")
            print("Thank you for using Pac-Man SimpleInstaller!")
            break

        else:
            print("Invalid option.")
            input("Press Enter to continue...")


if __name__ == "__main__":
    if shutil.which("pacman") is None:
        print("Error: This program requires Arch Linux or pacman.")
    else:
        main()
